# quadrocketbuilder export of 62mm Quad Monoplane 9in: INAV mixer profiles of the tailsitter, structured as the real m62v1
# config that flew forward (Aug 2025): profile 1 hover (multirotor, tailsitter offset), profile 2 forward flight on
# the motors (multirotor platform, nose-first mix). Motor outputs in INAV quad X order where it applies.
set throttle_idle = 8
set nav_mc_hover_thr = 1255    # predicted motor command 0.314 for 3.70 N per motor
mixer_profile 1
set platform_type = MULTIROTOR
set tailsitter_orientation_offset = ON
set motor_direction_inverted = OFF
set mixer_control_profile_linking = ON
mmix reset
mmix 0 1.000 -1.000 +1.000 +1.000    # motor 1 9in-puller 1, ccw
mmix 1 1.000 -1.000 -1.000 -1.000    # motor 1 9in-puller 3, cw
mmix 2 1.000 +1.000 +1.000 -1.000    # motor 1 9in-puller 2, cw
mmix 3 1.000 +1.000 -1.000 +1.000    # motor 1 9in-puller 4, ccw
mixer_profile 2
set platform_type = MULTIROTOR
set tailsitter_orientation_offset = OFF
set motor_direction_inverted = OFF
set mixer_control_profile_linking = ON
mmix reset
mmix 0 1.000 -1.000 +1.000 -1.000    # motor 1 9in-puller 1, ccw
mmix 1 1.000 +1.000 -1.000 -1.000    # motor 1 9in-puller 3, cw
mmix 2 1.000 +1.000 +1.000 +1.000    # motor 1 9in-puller 2, cw
mmix 3 1.000 -1.000 -1.000 +1.000    # motor 1 9in-puller 4, ccw
mixer_profile 1
set mag_hardware = FAKE
set nav_mc_althold_throttle = MID_STICK    # centre stick holds altitude
# switches: AUX1 arm, AUX2 angle, AUX3 mid althold / high poshold, AUX4 mid mixer transition / high mixer profile 2
aux 0 0 0 1700 2100
aux 1 1 1 1300 2100
aux 2 3 2 1300 1700
aux 3 11 2 1700 2100
aux 4 63 3 1300 1700
aux 5 62 3 1700 2100
set receiver_type = SIM (SITL)
set baro_hardware = FAKE
set pitot_hardware = NONE
feature GPS
set gps_provider = MSP
set init_gyro_cal = OFF
