<brushless_dc_motor name="Flashobby A2812 900KV">
  <velocityconstant> 900.0 </velocityconstant>
  <coilresistance> 0.24040 </coilresistance>
  <noloadcurrent> 0.0000 </noloadcurrent>
  <maxvolts> 24.920 </maxvolts>
</brushless_dc_motor>
