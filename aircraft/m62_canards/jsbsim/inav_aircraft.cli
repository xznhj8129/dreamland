# quadrocketbuilder export of 62mm Quad 7in v0: INAV mixer profiles of the tailsitter, structured as the real m62v1
# config that flew forward (Aug 2025): profile 1 hover (multirotor, tailsitter offset), profile 2 forward flight on
# the motors (multirotor platform, nose-first mix). Motor outputs in INAV quad X order where it applies.
set throttle_idle = 8
set nav_mc_hover_thr = 1233    # predicted motor command 0.295 for 2.56 N per motor
mixer_profile 1
set platform_type = MULTIROTOR
set tailsitter_orientation_offset = ON
set motor_direction_inverted = OFF
set mixer_control_profile_linking = ON
mmix reset
mmix 0 1.000 -1.000 +1.000 +1.000    # motor 1 qrwing-7in 1, ccw
mmix 1 1.000 -1.000 -1.000 -1.000    # motor 1 qrwing-7in 3, cw
mmix 2 1.000 +1.000 +1.000 -1.000    # motor 1 qrwing-7in 2, cw
mmix 3 1.000 +1.000 -1.000 +1.000    # motor 1 qrwing-7in 4, ccw
smix reset
smix 0 0 1 -100 0 -1    # S1 pitch: C2 canards panel 1
smix 1 0 2 -100 0 -1    # S1 roll: C2 canards panel 1
smix 2 1 1 -100 0 -1    # S2 pitch: C4 canards panel 2
smix 3 1 2 100 0 -1    # S2 roll: C4 canards panel 2
smix 4 2 2 -100 0 -1    # S3 roll: C1 canards panel 3
smix 5 2 0 100 0 -1    # S3 yaw: C1 canards panel 3
smix 6 3 2 100 0 -1    # S4 roll: C3 canards panel 4
smix 7 3 0 100 0 -1    # S4 yaw: C3 canards panel 4
# C1 canards panel 3: pitch not mixed, its pitch moment is 2% of its largest
# C2 canards panel 1: yaw not mixed, its yaw moment is 1% of its largest
# C3 canards panel 4: pitch not mixed, its pitch moment is 2% of its largest
# C4 canards panel 2: yaw not mixed, its yaw moment is 1% of its largest
mixer_profile 2
set platform_type = MULTIROTOR
set tailsitter_orientation_offset = OFF
set motor_direction_inverted = OFF
set mixer_control_profile_linking = ON
mmix reset
mmix 0 1.000 -1.000 +1.000 -1.000    # motor 1 qrwing-7in 1, ccw
mmix 1 1.000 +1.000 -1.000 -1.000    # motor 1 qrwing-7in 3, cw
mmix 2 1.000 +1.000 +1.000 +1.000    # motor 1 qrwing-7in 2, cw
mmix 3 1.000 -1.000 -1.000 +1.000    # motor 1 qrwing-7in 4, ccw
smix reset
smix 0 0 1 -100 0 -1    # S1 pitch: C2 canards panel 1
smix 1 0 0 100 0 -1    # S1 roll: C2 canards panel 1
smix 2 1 1 -100 0 -1    # S2 pitch: C4 canards panel 2
smix 3 1 0 -100 0 -1    # S2 roll: C4 canards panel 2
smix 4 2 0 100 0 -1    # S3 roll: C1 canards panel 3
smix 5 2 2 100 0 -1    # S3 yaw: C1 canards panel 3
smix 6 3 0 -100 0 -1    # S4 roll: C3 canards panel 4
smix 7 3 2 100 0 -1    # S4 yaw: C3 canards panel 4
# C1 canards panel 3: pitch not mixed, its pitch moment is 2% of its largest
# C2 canards panel 1: yaw not mixed, its yaw moment is 1% of its largest
# C3 canards panel 4: pitch not mixed, its pitch moment is 2% of its largest
# C4 canards panel 2: yaw not mixed, its yaw moment is 1% of its largest
mixer_profile 1
